{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/test222",
      "destination": "/test222.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "leap-red.vercel.app"
        }
      ],
      "destination": "https://www.leap-transport.com/$1",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/news.html",
      "permanent": true
    },
    {
      "source": "/blog/category/4",
      "destination": "/news.html",
      "permanent": true
    },
    {
      "source": "/blog/category/5",
      "destination": "/recruit.html",
      "permanent": true
    },
    {
      "source": "/blog/date/202601",
      "destination": "/news.html#news-2026-01-03",
      "permanent": true
    },
    {
      "source": "/blog/detail/48",
      "destination": "/news.html#news-2024-08-09",
      "permanent": true
    },
    {
      "source": "/blog/detail/49",
      "destination": "/news.html#news-2024-09-28",
      "permanent": true
    },
    {
      "source": "/blog/detail/50",
      "destination": "/news.html#news-2025-01-03",
      "permanent": true
    },
    {
      "source": "/blog/detail/51",
      "destination": "/news.html#news-2025-04-28",
      "permanent": true
    },
    {
      "source": "/blog/detail/52",
      "destination": "/news.html#news-2026-01-03",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=300"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
