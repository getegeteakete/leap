{
  "version": 2,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*\\.(png|jpg|jpeg|webp|gif|svg|mp4|webm|woff|woff2))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*\\.(css|js))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
